# ─────────────────────────────────────────────────────────────────────────────
# Scritur backend environment template
# Local development (root):     cp .env.example .env  → edit values
# Production (Render):          set these in Render → Environment as plain vars
#
# NEVER commit real secrets. Only this *.env.example file is tracked by git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── LLM provider (OpenRouter or any OpenAI-compatible endpoint) ────────────
# Required. For OpenRouter use your sk-or-v1-... key.
OPENAI_API_KEY=your_openai_api_key_here
# Enable OpenRouter (must point at the OpenAI-compatible proxy).
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Use OpenRouter model IDs (e.g. openai/gpt-4o-mini). Required when using OpenRouter.
OPENAI_MODEL=openai/gpt-4o-mini
# Embeddings are also served by OpenRouter (/api/v1/embeddings).
# Use the OpenRouter model ID so indexing + retrieval stay on OpenRouter.
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

# ─── Server ──────────────────────────────────────────────────────────────────
# Render sets $PORT automatically and overrides the docker CMD's default.
# Keep as-is locally.
PORT=3001
# Production on Render MUST be `production` (enables prod validation, disables
# debug error detail in responses).
NODE_ENV=development
# Comma-separated list of allowed frontend origins for CORS.
# Production: your Render frontend origin, e.g. https://scritur.onrender.com
# or your Cloudflare-backed custom domain (https://yourdomain.com).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Auth (Legacy fallback — kept for backward compatibility) ────────────────
# Generate a strong random secret (e.g. `openssl rand -hex 32`). Not the source
# of truth for Supabase tokens, but required for the legacy JWT path.
JWT_SECRET=generate-a-random-secret-key-here

# ─── Database — PostgreSQL (Supabase) ────────────────────────────────────────
# Local development (adjust port/host as needed):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/knowledgeos
# Production (Supabase direct connection, port 5432 — required for Alembic
# migrations; do NOT use the pgbouncer transaction-pooler port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?sslmode=require
# Connection pooling/pre_ping is already tuned in app/database.py.

# ─── Supabase Auth — Required for email/password + OAuth ─────────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-auth-settings

# ─── Chroma Cloud (vector DB) ─────────────────────────────────────────────────
# REQUIRED for production. Set CHROMA_API_KEY to use Chroma Cloud (takes
# precedence). Get from: https://your-tenant.trychroma.com → API keys.
# If CHROMA_API_KEY is unset and CHROMA_HOST is set, a self-hosted Chroma HTTP
# server is used instead. If NEITHER is set, the backend fails fast on first
# vector use (no local/PersistentClient fallback — that is intentional).
CHROMA_API_KEY=your-chroma-cloud-api-key
CHROMA_TENANT=your-chroma-tenant
CHROMA_DATABASE=default_database
# Self-hosted Chroma over HTTP (local docker-compose `chromadb` service) only:
# CHROMA_HOST=chromadb
# CHROMA_PORT=8000
# CHROMA_SSL=false
# The legacy VECTOR_STORAGE_PATH option was REMOVED — Chroma indexes are now
# server-side (Chroma Cloud) and survive Render redeploys.

# ─── Error tracking (optional) ───────────────────────────────────────────────
# SENTRY_DSN=https://your-dsn@sentry.io/your-project

# ─── Logging (optional) ──────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# JSON_LOGS=true

# ─── Whisper fallback — auto-transcribe no-caption videos ────────────────────
# Disable if you do not want the audio-download + Whisper transcription path.
# Requires ffmpeg in the image (the backend Dockerfile installs it).
ENABLE_WHISPER_FALLBACK=true
WHISPER_MODEL=whisper-1
